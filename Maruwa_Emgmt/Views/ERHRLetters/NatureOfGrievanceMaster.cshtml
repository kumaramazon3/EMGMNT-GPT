@{
    ViewData["Title"] = "Nature of Grievance Master";
}

<style>
    .nature-custom-modal {
        max-width: 80vw !important;
        width: 80vw !important;
    }

    .nature-custom-modal .modal-content {
        min-height: 80vh;
    }

    .nature-custom-modal .modal-body {
        min-height: calc(80vh - 130px);
        display: flex;
        justify-content: center;
        align-items: center;
        overflow-y: auto;
        padding: 35px 20px;
    }

    .nature-form-wrapper {
        width: 100%;
        max-width: 820px;
        margin: 0 auto;
    }

    .nature-form-row {
        width: 100%;
        margin: 0 auto 22px auto;
    }

    .nature-form-row label {
        font-size: 17px;
        font-weight: 600;
        color: #34446b;
        text-align: right;
        padding-right: 8px !important;
        margin-bottom: 0;
        white-space: nowrap;
    }

    .nature-form-wrapper .form-control,
    .nature-form-wrapper select,
    .nature-form-wrapper textarea {
        font-size: 16px;
        border: 2px solid #42cef5;
        border-radius: 6px;
        box-shadow: none;
    }

    .nature-form-wrapper .form-control,
    .nature-form-wrapper select {
        height: 42px;
    }

    .nature-form-wrapper textarea.form-control {
        min-height: 96px;
        resize: vertical;
    }

    .nature-form-wrapper .form-control:focus,
    .nature-form-wrapper select:focus,
    .nature-form-wrapper textarea:focus {
        border-color: #0d6efd;
        box-shadow: 0 0 5px rgba(13, 110, 253, .35);
    }

    .required-star {
        color: #dc3545;
        font-weight: 700;
        margin-left: 4px;
    }

    .nature-modal-footer {
        display: flex;
        justify-content: center !important;
        align-items: center;
        gap: 20px;
        border-top: none;
        padding: 20px 0 30px;
    }

    .nature-modal-footer .btn {
        min-width: 120px;
    }

    .error-border {
        border: 2px solid #dc3545 !important;
        background: #fff5f5;
    }

    .valid-border {
        border: 2px solid #0d6efd !important;
    }

    .inactive-edit-confirm-modal {
        z-index: 1065;
    }

    .inactive-edit-confirm-modal .modal-dialog {
        max-width: 520px;
    }

    @@media (max-width: 768px) {
        .nature-custom-modal {
            width: 95vw !important;
            max-width: 95vw !important;
        }

        .nature-custom-modal .modal-body {
            align-items: flex-start;
            padding: 25px 10px;
        }

        .nature-form-wrapper {
            max-width: 95%;
        }

        .nature-form-row label {
            text-align: left;
            margin-bottom: 6px;
            padding-right: 4px !important;
        }
    }
</style>

<div class="container-fluid mt-3">
    @Html.AntiForgeryToken()
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <span>Nature of Grievance / Complaint Master</span>
            <button type="button" class="btn btn-light btn-sm" onclick="openNatureModal()"><i class="bi bi-plus-circle"></i> Add Nature</button>
        </div>
        <div class="card-body">
            <div class="row mb-2 align-items-center">
                <div class="col-md-2">
                    <select id="pageSizeSelect" class="form-control form-control-sm">
                        <option value="5">5</option>
                        <option value="10" selected>10</option>
                        <option value="25">25</option>
                        <option value="50">50</option>
                        <option value="100">100</option>
                    </select>
                </div>
                <div class="col-md-7">
                    <input type="text" id="globalSearch" class="form-control form-control-sm" placeholder="Global search across Nature of Grievance columns" />
                </div>
                <div class="col-md-3 text-right">
                    <button class="btn btn-success btn-sm" onclick="exportNature('xlsx')">Excel</button>
                    <button class="btn btn-info btn-sm" onclick="exportNature('csv')">CSV</button>
                    <button class="btn btn-danger btn-sm" onclick="exportNature('pdf')">PDF</button>
                    <button class="btn btn-secondary btn-sm" onclick="window.print()">Print</button>
                </div>
            </div>
            <div class="table-responsive">
                <table class="table table-bordered table-hover table-sm" id="tblNature" style="font-size:13px;">
                    <thead class="bg-secondary text-white">
                        <tr>
                            <th>Edit</th>
                            <th>Delete</th>
                            <th data-sort="NatureName">Nature of Grievance / Complaint</th>
                            <th data-sort="IsOther">Is Other</th>
                            <th data-sort="CreatedBy">Created By</th>
                            <th data-sort="CreatedOn">Created On</th>
                            <th data-sort="EditedBy">Edited By</th>
                            <th data-sort="EditedOn">Edited On</th>
                            <th data-sort="isActive">isActive</th>
                        </tr>
                        <tr class="bg-light text-dark">
                            <th></th>
                            <th></th>
                            <th><input class="form-control form-control-sm column-search" data-field="natureName" /></th>
                            <th><input class="form-control form-control-sm column-search" data-field="isOther" /></th>
                            <th><input class="form-control form-control-sm column-search" data-field="createdBy" /></th>
                            <th></th>
                            <th><input class="form-control form-control-sm column-search" data-field="editedBy" /></th>
                            <th></th>
                            <th><input class="form-control form-control-sm column-search" data-field="isActive" /></th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
            <div class="d-flex justify-content-between align-items-center">
                <span id="recordInfo"></span>
                <div>
                    <button class="btn btn-outline-secondary btn-sm" id="btnPrev">Prev</button>
                    <span id="pageInfo" class="mx-2"></span>
                    <button class="btn btn-outline-secondary btn-sm" id="btnNext">Next</button>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="natureModal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-dialog-centered nature-custom-modal" role="document">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="natureModalTitle">Add Nature of Grievance</h5>
                <button type="button" class="close text-white" data-dismiss="modal"><span>&times;</span></button>
            </div>
            <div class="modal-body">
                <div class="nature-form-wrapper">
                    <form id="natureForm">
                        <input type="hidden" id="natureID" name="NatureID" value="0" />

                        <div class="row gx-0 justify-content-center align-items-start nature-form-row">
                            <label class="col-md-4 col-form-label text-end pe-1">Nature of Grievance<span class="required-star">*</span></label>
                            <div class="col-md-6 ps-1">
                                <textarea class="form-control" id="natureName" name="NatureName" required maxlength="300" rows="3"></textarea>
                            </div>
                        </div>

                        <div class="row gx-0 justify-content-center align-items-center nature-form-row">
                            <label class="col-md-4 col-form-label text-end pe-1">Other Option</label>
                            <div class="col-md-6 ps-1">
                                <label class="mb-0"><input type="checkbox" id="isOther" name="IsOther" value="true" /> Mark as Other option</label>
                            </div>
                        </div>

                        <div class="alert d-none" id="formMessage"></div>
                    </form>
                </div>
            </div>
            <div class="modal-footer justify-content-center nature-modal-footer">
                <button type="button" class="btn btn-secondary px-4" data-dismiss="modal"><i class="fa fa-times"></i> Cancel</button>
                <button type="button" class="btn btn-primary px-4" onclick="saveNature()"><i class="fa fa-save"></i> Save</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade inactive-edit-confirm-modal" id="inactiveEditConfirmModal" tabindex="-1" role="dialog" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content border-warning">
            <div class="modal-header bg-warning text-dark">
                <h5 class="modal-title">Confirm Edit</h5>
                <button type="button" class="close text-dark" onclick="cancelInactiveEdit()"><span>&times;</span></button>
            </div>
            <div class="modal-body text-center">
                <p class="mb-0 font-weight-bold">You are going to edit the Inactive record, please confirm if you want to proceed?</p>
            </div>
            <div class="modal-footer justify-content-center">
                <button type="button" class="btn btn-secondary px-4" onclick="cancelInactiveEdit()">Cancel</button>
                <button type="button" class="btn btn-warning px-4" onclick="proceedInactiveEdit()">Proceed</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="deleteNatureModal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white"><h5 class="modal-title">Confirm Delete</h5><button type="button" class="close text-white" data-dismiss="modal"><span>&times;</span></button></div>
            <div class="modal-body">Are you sure you want to delete this Nature of Grievance?</div>
            <div class="modal-footer"><button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button><button type="button" class="btn btn-danger" id="btnConfirmNatureDelete">Delete</button></div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/ERHRLetters/jsNatureOfGrievanceMaster.js" asp-append-version="true"></script>
}
