@{
    ViewData["Title"] = "Leave Application";
}

<style>
    .leave-page-wrapper {
        background: #f4f7fb;
        padding: 14px 8px 24px 8px;
    }

    .leave-card {
        border: 1px solid #dbe3ef;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 6px 18px rgba(31, 45, 61, 0.10);
        background: #ffffff;
    }

    .leave-title-bar {
        background: linear-gradient(135deg, #2f5597, #4e73df);
        color: #ffffff;
        font-weight: 700;
        text-align: center;
        padding: 12px 10px;
        font-size: 20px;
        letter-spacing: .5px;
        text-transform: uppercase;
        border-bottom: 1px solid #27477f;
    }

    .leave-summary-panel {
        padding: 16px;
        background: linear-gradient(180deg, #ffffff 0%, #f7faff 100%);
        border-bottom: 1px solid #dbe3ef;
    }


    .leave-summary-heading {
        text-align: center;
        font-size: 18px;
        font-weight: 800;
        color: #223a5e;
        letter-spacing: .4px;
        text-transform: uppercase;
        margin: 0 0 14px 0;
        padding: 10px 12px;
        border: 1px solid #c8d3e3;
        border-radius: 10px;
        background: linear-gradient(135deg, #eef3fb, #ffffff);
        box-shadow: inset 0 1px 0 rgba(255,255,255,.85);
    }

    .summary-card {
        height: 100%;
        background: #ffffff;
        border: 2px solid #dbe3ef;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 5px 14px rgba(31, 45, 61, 0.08);
    }

    .summary-card-header {
        color: #ffffff;
        font-weight: 700;
        text-align: center;
        padding: 10px 12px;
        font-size: 16px;
        letter-spacing: .3px;
    }

    .summary-card-body {
        padding: 12px 16px;
    }

    .summary-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        padding: 9px 0;
        border-bottom: 1px dashed #d6deea;
        color: #263b5e;
        font-size: 14px;
    }

    .summary-row:last-child {
        border-bottom: none;
    }

    .summary-label {
        font-weight: 700;
    }

    .summary-metric-label {
        flex: 1;
        font-weight: 600;
    }

    .summary-metric-value {
        min-width: 58px;
        text-align: center;
        border-radius: 20px;
        padding: 4px 12px;
        font-weight: 700;
        border: 1px solid rgba(0,0,0,.08);
        background: #ffffff;
        box-shadow: inset 0 1px 0 rgba(255,255,255,.8);
    }

    .carry-card {
        border-color: #8bd875;
    }

    .carry-card .summary-card-header {
        background: linear-gradient(135deg, #4da83d, #8bd875);
    }

    .carry-card .summary-metric-value {
        color: #287a20;
        background: #f1fff0;
    }

    .annual-card {
        border-color: #f1dc5d;
    }

    .annual-card .summary-card-header {
        background: linear-gradient(135deg, #c5a600, #ffe66b);
        color: #23375b;
    }

    .annual-card .summary-metric-value {
        color: #816700;
        background: #fffbea;
    }

    .medical-card {
        border-color: #75d7df;
    }

    .medical-card .summary-card-header {
        background: linear-gradient(135deg, #2291a3, #75d7df);
    }

    .medical-card .summary-metric-value {
        color: #167385;
        background: #effcff;
    }

    .total-balance-card {
        margin-top: 14px;
        border: 1px solid #c8d3e3;
        border-radius: 10px;
        background: linear-gradient(135deg, #eef3fb, #ffffff);
        color: #223a5e;
        padding: 10px 14px;
        text-align: center;
        font-size: 16px;
        font-weight: 700;
        box-shadow: inset 0 1px 0 rgba(255,255,255,.8);
    }

    .total-balance-card span {
        display: inline-block;
        margin-left: 12px;
        padding: 3px 18px;
        border-radius: 18px;
        background: #2f5597;
        color: #ffffff;
        min-width: 70px;
    }

    .leave-section-title {
        background: linear-gradient(135deg, #2f5597, #2f7fbd);
        color: #ffffff;
        font-weight: 700;
        padding: 9px 14px;
        letter-spacing: .2px;
        border-top: 1px solid #224274;
        border-bottom: 1px solid #224274;
    }

    .new-leave-body {
        border: 1px solid #dbe3ef;
        border-top: none;
        background: #ffffff;
    }

    .leave-form-label {
        background: #d9e8f7;
        color: #1f355b;
        font-weight: 700;
        padding: 10px 12px;
        min-height: 46px;
        display: flex;
        align-items: center;
        border-right: 1px solid #c5d6ea;
        border-bottom: 1px solid #dbe3ef;
    }

    .form-row.no-gutters > .p-2,
    .form-row.no-gutters > .bg-light {
        border-bottom: 1px solid #e6ecf5;
    }

    .form-control {
        border: 2px solid #2fc3f2;
        border-radius: 7px;
        color: #495057;
        min-height: 38px;
    }

    .form-control:focus {
        border-color: #1a73e8;
        box-shadow: 0 0 0 0.15rem rgba(26, 115, 232, .15);
    }

    .required-star { color: red; margin-left: 3px; }
    .error-border { border: 2px solid #dc3545 !important; }
    .valid-border { border: 2px solid #1cc88a !important; }

    .condition-card {
        background: linear-gradient(135deg, #243b55, #141e30);
        color: #ffffff;
        border: 1px solid #1b2e4a;
        border-radius: 12px;
        box-shadow: 0 5px 14px rgba(31, 45, 61, 0.18);
    }

    .condition-card h5 {
        color: #ffffff;
        border-bottom: 1px solid rgba(255,255,255,.25);
        padding-bottom: 8px;
    }

    .employee-info-card {
        border: 1px solid #dbe3ef;
        border-radius: 12px;
        padding: 14px;
        background: #f8fbff;
        color: #263b5e;
        box-shadow: inset 0 1px 0 rgba(255,255,255,.9);
    }

    .pic-heading {
        background: #c7daf0;
        color: #1f355b;
        font-weight: 700;
        padding: 10px 12px;
        border: 1px solid #b8cce2;
        border-radius: 6px 6px 0 0;
    }

    .btn-apply {
        min-width: 150px;
        font-weight: 700;
        border-width: 2px;
    }

    .search-note { font-size: 11px; color: #6c757d; margin-top: 4px; }
    .d-none-force { display: none !important; }

    @@media (max-width: 767.98px) {
        .leave-form-label { border-right: none; }
        .leave-summary-panel { padding: 10px; }
        .summary-card { margin-bottom: 12px; }
    }
</style>

<div class="container-fluid mt-3 leave-page-wrapper">
    <div class="card shadow leave-card">
        <div class="card-body p-0">
            <div class="leave-title-bar">LEAVE APPLICATION</div>

            <div class="leave-summary-panel">
                <div class="leave-summary-heading">Leave Summary</div>
                <div class="row">
                    <div class="col-lg-4 col-md-6 mb-3 mb-lg-0">
                        <div class="summary-card carry-card">
                            <div class="summary-card-header">Carry Forward Leave</div>
                            <div class="summary-card-body">
                                <div class="summary-row">
                                    <span class="summary-metric-label">Total Carry Forward</span>
                                    <span class="summary-metric-value" id="carryForwardTotal">0</span>
                                </div>
                                <div class="summary-row">
                                    <span class="summary-metric-label">Utilised</span>
                                    <span class="summary-metric-value" id="carryForwardUtilised">0</span>
                                </div>
                                <div class="summary-row">
                                    <span class="summary-metric-label">Balance</span>
                                    <span class="summary-metric-value" id="carryForwardBalance">0</span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-4 col-md-6 mb-3 mb-lg-0">
                        <div class="summary-card annual-card">
                            <div class="summary-card-header">Annual Leave</div>
                            <div class="summary-card-body">
                                <div class="summary-row">
                                    <span class="summary-metric-label">Entitlement</span>
                                    <span class="summary-metric-value" id="annualEntitlement">0</span>
                                </div>
                                <div class="summary-row">
                                    <span class="summary-metric-label">Utilised</span>
                                    <span class="summary-metric-value" id="annualUtilised">0</span>
                                </div>
                                <div class="summary-row">
                                    <span class="summary-metric-label">Balance</span>
                                    <span class="summary-metric-value" id="annualBalance">0</span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-4 col-md-12">
                        <div class="summary-card medical-card">
                            <div class="summary-card-header">Medical Leave</div>
                            <div class="summary-card-body">
                                <div class="summary-row">
                                    <span class="summary-metric-label">Medical Leave Entitlement</span>
                                    <span class="summary-metric-value" id="medicalEntitlement">0</span>
                                </div>
                                <div class="summary-row">
                                    <span class="summary-metric-label">Medical Leave Utilised</span>
                                    <span class="summary-metric-value" id="medicalUtilised">0</span>
                                </div>
                                <div class="summary-row">
                                    <span class="summary-metric-label">Medical Leave Balance</span>
                                    <span class="summary-metric-value" id="medicalBalance">0</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="total-balance-card">
                    Total Entitlement Balance <span id="totalEntitlementBalance">0</span>
                </div>
            </div>
            <div class="leave-section-title mt-4">New Leave Details</div>
            <input type="hidden" id="editAppNo" value="" />
            <div class="row no-gutters p-0 new-leave-body">
                <div class="col-md-7">
                    <div class="form-row no-gutters">
                        <div class="col-md-3 leave-form-label">Leave App No</div>
                        <div class="col-md-9 p-2 bg-light"><input type="text" id="leaveAppNo" class="form-control" value="Auto Generated" readonly /></div>
                    </div>
                    <div class="form-row no-gutters">
                        <div class="col-md-3 leave-form-label">Leave Type <span class="required-star">*</span></div>
                        <div class="col-md-9 p-2">
                            <input type="text" id="leaveTypeSearch" class="form-control" list="leaveTypeOptions" placeholder="Key in or search Leave Type" autocomplete="off" />
                            <datalist id="leaveTypeOptions"></datalist>
                            <select id="leaveType" class="d-none" aria-hidden="true" tabindex="-1"><option value="">- Select Leave type -</option></select>
                            <div class="search-note">Key in leave type code/name and select the matching leave type from the same search field.</div>
                        </div>
                    </div>
                    <div class="form-row no-gutters">
                        <div class="col-md-3 leave-form-label">Leave Period <span class="required-star">*</span></div>
                        <div class="col-md-9 p-2 d-flex align-items-center"><input type="date" id="fromDate" class="form-control mr-2" /><span>~</span><input type="date" id="toDate" class="form-control ml-2" /></div>
                    </div>
                    <div class="form-row no-gutters">
                        <div class="col-md-3 leave-form-label">Half-Day Leave</div>
                        <div class="col-md-9 p-2 d-flex align-items-center"><input type="checkbox" id="isHalfDay" class="mr-2" /><select id="halfDayLeave" class="form-control" disabled><option value="">-Select Half Day Leave Time -</option></select></div>
                    </div>
                    <div class="form-row no-gutters">
                        <div class="col-md-3 leave-form-label">Leave Days <span class="required-star">*</span></div>
                        <div class="col-md-9 p-2"><input type="number" id="leaveDays" step="0.5" min="0.5" class="form-control" readonly /><span id="leaveDaysError" class="text-danger small"></span></div>
                    </div>
                    <div class="form-row no-gutters">
                        <div class="col-md-3 leave-form-label">Reason <span class="required-star">*</span></div>
                        <div class="col-md-9 p-2">
                            <select id="reason" class="form-control mb-2"><option value="">-Select-</option></select>
                            <textarea id="reasonText" class="form-control" rows="2" placeholder="Enter reason"></textarea>
                            <div class="search-note" id="reasonLogicNote">For Medical Leave use dropdown. For other leave types enter reason in text box.</div>
                        </div>
                    </div>
                    <div id="picBlock">
                        <div class="pic-heading mt-2">Person in Charge When You are in Leave ! (One PIC is Must)</div>
                        <div class="form-row no-gutters">
                            <div class="col-md-3 leave-form-label">Person in Charge 1 <span class="required-star">*</span></div>
                            <div class="col-md-9 p-2">
                                <input type="text" id="personInCharge1Search" class="form-control" list="personInChargeOptions" placeholder="Key in or search Emp Id / Name" />
                                <input type="hidden" id="personInCharge1" />
                            </div>
                        </div>
                        <div class="form-row no-gutters">
                            <div class="col-md-3 leave-form-label">Person in Charge 2</div>
                            <div class="col-md-9 p-2">
                                <input type="text" id="personInCharge2Search" class="form-control" list="personInChargeOptions" placeholder="Key in or search Emp Id / Name" />
                                <input type="hidden" id="personInCharge2" />
                            </div>
                        </div>
                        <datalist id="personInChargeOptions"></datalist>
                    </div>
                    <div class="text-center my-3">
                        <button type="button" id="btnApplyLeave" class="btn btn-outline-dark btn-apply">APPLY LEAVE</button>
                        <a href="~/leave/LeaveSelfStatus" class="btn btn-outline-secondary ml-2">Self Status</a>
                    </div>
                </div>
                <div class="col-md-5 p-3">
                    <div class="mb-3 employee-info-card">
                        <h6 class="font-weight-bold mb-2">Employee Details</h6>
                        <div><b>Name:</b> <span id="empName"></span></div>
                        <div><b>Department / Section:</b> <span id="department"></span></div>
                        <div><b>Designation:</b> <span id="designation"></span></div>
                    </div>
                    <div class="condition-card p-3">
                        <h5 class="font-weight-bold text-decoration-underline mb-3">Conditions For Applying Annual Leave</h5>
                        <ol class="pl-3 mb-0">
                            <li>For Half a day - Should apply one day before</li>
                            <li>For one day - Should apply three days before</li>
                            <li>More than one day - Should apply seven days before</li>
                            <li>Emergency leave can be applied prior, same day, or within 3 days after resuming work.</li>
                            <li>Company Holiday should be applied one month before leave date.</li>
                        </ol>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="leaveResultModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white"><h5 class="modal-title" id="leaveResultModalLabel">Leave Submission</h5><button type="button" class="close text-white" data-dismiss="modal"><span>&times;</span></button></div>
            <div class="modal-body" id="leaveResultMessage"></div>
            <div class="modal-footer"><button type="button" class="btn btn-primary" data-dismiss="modal">OK</button></div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/leaves/jsLeaveApplication.js" asp-append-version="true"></script>
}
