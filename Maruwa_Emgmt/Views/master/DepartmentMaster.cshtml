@{
    ViewData["Title"] = "Department Master";
}
<style>
    .custom-modal {
        max-width: 80vw !important;
        width: 80vw !important;
    }

        .custom-modal .modal-content {
            min-height: 80vh;
        }

        .custom-modal .modal-body {
            min-height: calc(80vh - 130px);
            display: flex;
            justify-content: center;
            align-items: center;
            overflow-y: auto;
            padding: 30px 20px;
        }

    .department-form-wrapper {
        width: 100%;
        max-width: 760px;
        margin: 0 auto;
    }

    .department-form-row {
        width: 100%;
        margin: 0 auto 18px auto;
    }

        .department-form-row label {
            font-size: 17px;
            font-weight: 600;
            color: #5f6678;
            text-align:;
            padding-right: 6px !important;
            margin-bottom: 0;
            white-space: nowrap;
        }

        .department-form-row .col-md-4,
        .department-form-row .col-md-6 {
            padding-left: 4px !important;
            padding-right: 4px !important;
        }

        .department-form-row .form-control,
        .department-form-row select {
            height: 42px;
            font-size: 16px;
        }

    .department-form-wrapper .form-control,
    .department-form-wrapper .form-select,
    .department-form-wrapper select {
        border: 2px solid #42cef5;
        border-radius: 6px;
        box-shadow: none;
    }

        .department-form-wrapper .form-control:focus,
        .department-form-wrapper .form-select:focus,
        .department-form-wrapper select:focus {
            border-color: #0d6efd;
            box-shadow: 0 0 5px rgba(13, 110, 253, .35);
        }

    .department-modal-footer {
        display: flex;
        justify-content: center !important;
        align-items: center;
        gap: 15px;
        border-top: none;
        padding: 20px 0 25px;
    }

        .department-modal-footer .btn {
            min-width: 120px;
        }

    .error-border {
        border: 2px solid #dc3545 !important;
        background: #fff5f5;
    }

    .valid-border {
        border: 2px solid #0d6efd !important;
    }

    .department-modal-footer {
        border-top: 0;
        padding-bottom: 30px;
    }

        .department-modal-footer .btn {
            min-width: 100px;
        }

    @@media (max-width: 768px) {
        .custom-modal {
            width: 95vw !important;
            max-width: 95vw !important;
        }

            .custom-modal .modal-body {
                align-items: flex-start;
                padding: 25px 10px;
            }

        .department-form-wrapper {
            max-width: 95%;
        }

        .department-form-row label {
            text-align: left;
            padding-right: 4px !important;
            margin-bottom: 6px;
        }
    }
</style>

<div class="container-fluid mt-3">
    @Html.AntiForgeryToken()

    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <span>Department Master</span>
            <button type="button" class="btn btn-light btn-sm" onclick="openDepartmentModal()"><i class="bi bi-plus-circle"></i> Add Department</button>
        </div>
        <div class="card-body">
             <div class="row mb-2 align-items-center">
                <div class="col-md-2">
                    <select id="pageSizeSelect" class="form-control form-control-sm">
                        <option value="5">5</option>
                        <option value="10" selected>10</option>
                        <option value="25">25</option>
                        <option value="50">50</option>
                        <option value="100">100</option>
                    </select>
                </div>
                <div class="col-md-7">
                    <input type="text" id="globalSearch" class="form-control form-control-sm" placeholder="Global search across all columns" />
                </div>
                <div class="col-md-3 text-right">
                    <button class="btn btn-success btn-sm" onclick="exportDepartment('xlsx')">Excel</button>
                    <button class="btn btn-info btn-sm" onclick="exportDepartment('csv')">CSV</button>
                    <button class="btn btn-danger btn-sm" onclick="exportDepartment('pdf')">PDF</button>
                    <button class="btn btn-secondary btn-sm" onclick="window.print()">Print</button>
                </div>
            </div>
            <div class="table-responsive">
                <table class="table table-bordered table-hover table-sm" id="tblDepartment" style="font-size:13px;">
                    <thead class="bg-secondary text-white">
                         <tr>
                            <th>Edit</th>
                            <th>Delete</th>
                            <th data-sort="DepartmentCode">Department Code</th>
                            <th data-sort="DepartmentName">Department Name</th>
                            <th data-sort="JapanHead">Japan Head</th>
                            <th data-sort="Office">Office</th>
                            <th data-sort="GotSection">Got Section</th>
                            <th data-sort="Prefix">Prefix</th>
                            <th data-sort="CreatedBy">Created By</th>
                            <th data-sort="CreatedOn">Created On</th>
                            <th data-sort="EditedBy">Edited By</th>
                            <th data-sort="EditedOn">Edited On</th>
                            <th data-sort="ActiveStatus">Active Status</th>
                        </tr>
                       <tr class="bg-light text-dark">
                            <th></th><th></th>
                            <th><input class="form-control form-control-sm column-search" data-field="departmentCode" /></th>
                            <th><input class="form-control form-control-sm column-search" data-field="departmentName" /></th>
                            <th><input class="form-control form-control-sm column-search" data-field="japanHead" /></th>
                            <th><input class="form-control form-control-sm column-search" data-field="office" /></th>
                            <th><input class="form-control form-control-sm column-search" data-field="gotSection" /></th>
                            <th><input class="form-control form-control-sm column-search" data-field="prefix" /></th>
                            <th colspan="5"></th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
            <div class="d-flex justify-content-between align-items-center">
                <span id="recordInfo"></span>
                <div>
                    <button class="btn btn-outline-secondary btn-sm" id="btnPrev">Prev</button>
                    <span id="pageInfo" class="mx-2"></span>
                    <button class="btn btn-outline-secondary btn-sm" id="btnNext">Next</button>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="departmentModal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-dialog-centered custom-modal" role="document">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="departmentModalTitle">Add Department</h5>
                <button type="button" class="close text-white" data-dismiss="modal"><span>&times;</span></button>
            </div>

            <div class="modal-body">
                <div class="department-form-wrapper">
                    <form id="departmentForm">
                        <input type="hidden" id="recordNo" name="RecordNo" value="0" />

                        <div class="row gx-0 justify-content-center align-items-center department-form-row">
                            <label class="col-md-4 col-form-label text-end pe-1">Department Code <span class="text-danger">*</span></label>
                            <div class="col-md-6 ps-1">
                                <input class="form-control"
                                       id="departmentCode"
                                       name="DepartmentCode"
                                       maxlength="20"
                                       required />
                                
                            </div>
                        </div>

                        <div class="row gx-0 justify-content-center align-items-center department-form-row">
                            <label class="col-md-4 col-form-label text-end pe-1">Department Name <span class="text-danger">*</span></label>
                            <div class="col-md-6 ps-1">
                                <input class="form-control"
                                       id="departmentName"
                                       name="DepartmentName"
                                       maxlength="150"
                                       required />
                            </div>
                        </div>

                        <div class="row gx-0 justify-content-center align-items-center department-form-row">
                            <label class="col-md-4 col-form-label text-end pe-1">Get Japanese Head <span class="text-danger">*</span></label>
                            <div class="col-md-6 ps-1">
                                <select class="form-control"
                                        id="japanHead"
                                        name="JapanHead"
                                        required>
                                    <option value="">--Select--</option>
                                    <option>Yes</option>
                                    <option>No</option>
                                </select>
                            </div>
                        </div>

                        <div class="row gx-0 justify-content-center align-items-center department-form-row">
                            <label class="col-md-4 col-form-label text-end pe-1">Got Section <span class="text-danger">*</span></label>
                            <div class="col-md-6 ps-1">
                                <select class="form-control"
                                        id="gotSection"
                                        name="GotSection"
                                        required>
                                    <option value="">--Select--</option>
                                    <option>Yes</option>
                                    <option>No</option>
                                </select>
                            </div>
                        </div>

                        <div class="row gx-0 justify-content-center align-items-center department-form-row">
                            <label class="col-md-4 col-form-label text-end pe-1">Direct/Indirect Dept <span class="text-danger">*</span></label>
                            <div class="col-md-6 ps-1">
                                <select class="form-control"
                                        id="office"
                                        name="Office"
                                        required>
                                    <option value="">--Select--</option>
                                    <option>Direct</option>
                                    <option>Indirect</option>
                                </select>
                            </div>
                        </div>

                        <div class="row gx-0 justify-content-center align-items-center department-form-row">
                            <label class="col-md-4 col-form-label text-end pe-1">General Abbreviations <span class="text-danger">*</span></label>
                            <div class="col-md-6 ps-1">
                                <input class="form-control"
                                       id="prefix"
                                       name="Prefix"
                                       maxlength="20"
                                       required />
                                <span class="ms-2 fw-bold">(Extrusion - EX)</span>

                            </div>

                        </div>


                        <div class="modal-footer justify-content-center department-modal-footer">

                            <button type="button"
                                    class="btn btn-secondary me-3 px-4"
                                    data-dismiss="modal">
                                <i class="fa fa-times"></i> Close
                            </button>

                            <button type="button"
                                    class="btn btn-primary px-4"
                                    onclick="saveDepartment()">
                                <i class="fa fa-save"></i> Save
                            </button>

                        </div>

                        <div class="alert d-none" id="formMessage"></div>


                    </form>
                </div>
            </div>


        </div>
    </div>
</div>

<div class="modal fade" id="deleteDepartmentModal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white"><h5 class="modal-title">Confirm Delete</h5><button type="button" class="close text-white" data-dismiss="modal"><span>&times;</span></button></div>
            <div class="modal-body">Are you sure you want to delete this department?</div>
            <div class="modal-footer"><button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button><button type="button" class="btn btn-danger" id="btnConfirmDepartmentDelete">Delete</button></div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/master/jsDepartmentMaster.js"></script>
}
