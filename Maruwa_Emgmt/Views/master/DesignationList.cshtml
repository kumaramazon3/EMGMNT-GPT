@{
    ViewData["Title"] = "Designation Master";
}


<style>
    .master-custom-modal {
        max-width: 80vw !important;
        width: 80vw !important;
    }

        .master-custom-modal .modal-content {
            min-height: 80vh;
        }

        .master-custom-modal .modal-body {
            min-height: calc(80vh - 130px);
            display: flex;
            justify-content: center;
            align-items: center;
            overflow-y: auto;
            padding: 35px 20px;
        }

    .master-form-wrapper {
        width: 100%;
        max-width: 780px;
        margin: 0 auto;
    }

    .master-form-row {
        width: 100%;
        margin: 0 auto 22px auto;
    }

        .master-form-row label {
            font-size: 17px;
            font-weight: 600;
            color: #34446b;
            text-align: right;
            padding-right: 8px !important;
            margin-bottom: 0;
            white-space: nowrap;
        }

        .master-form-row .col-md-4,
        .master-form-row .col-md-6 {
            padding-left: 4px !important;
            padding-right: 4px !important;
        }

    .master-form-wrapper .form-control,
    .master-form-wrapper select,
    .master-form-wrapper textarea {
        font-size: 16px;
        border: 2px solid #42cef5;
        border-radius: 6px;
        box-shadow: none;
    }

    .master-form-wrapper .form-control,
    .master-form-wrapper select {
        height: 42px;
    }

    .master-form-wrapper textarea.form-control {
        min-height: 96px;
        resize: vertical;
    }

    .master-form-wrapper .form-control:focus,
    .master-form-wrapper select:focus,
    .master-form-wrapper textarea:focus {
        border-color: #0d6efd;
        box-shadow: 0 0 5px rgba(13, 110, 253, .35);
    }

    .required-star {
        color: #dc3545;
        font-weight: 700;
        margin-left: 4px;
    }

    .master-modal-footer {
        display: flex;
        justify-content: center !important;
        align-items: center;
        gap: 20px;
        border-top: none;
        padding: 20px 0 30px;
    }

        .master-modal-footer .btn {
            min-width: 120px;
        }

    .error-border {
        border: 2px solid #dc3545 !important;
        background: #fff5f5;
    }

    .valid-border {
        border: 2px solid #0d6efd !important;
    }

    .inactive-edit-confirm-modal {
        z-index: 1065;
    }

        .inactive-edit-confirm-modal .modal-dialog {
            max-width: 520px;
        }

    @@media (max-width: 768px) {
        .master-custom-modal {
            width: 95vw !important;
            max-width: 95vw !important;
        }

            .master-custom-modal .modal-body {
                align-items: flex-start;
                padding: 25px 10px;
            }

        .master-form-wrapper {
            max-width: 95%;
        }

        .master-form-row label {
            text-align: left;
            margin-bottom: 6px;
            padding-right: 4px !important;
        }
    }
</style>

<div class="container-fluid mt-3">
    @Html.AntiForgeryToken()
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <span>Designation Master</span>
            <button type="button" class="btn btn-light btn-sm" onclick="openDesignationModal()"><i class="bi bi-plus-circle"></i> Add Designation</button>
        </div>
        <div class="card-body">
            <div class="row mb-2 align-items-center">
                <div class="col-md-2">
                    <select id="pageSizeSelect" class="form-control form-control-sm">
                        <option value="5">5</option>
                        <option value="10" selected>10</option>
                        <option value="25">25</option>
                        <option value="50">50</option>
                        <option value="100">100</option>
                    </select>
                </div>
                <div class="col-md-7">
                    <input type="text" id="globalSearch" class="form-control form-control-sm" placeholder="Global search across all designation columns" />
                </div>
                <div class="col-md-3 text-right">
                    <button class="btn btn-success btn-sm" onclick="exportDesignation('xlsx')">Excel</button>
                    <button class="btn btn-info btn-sm" onclick="exportDesignation('csv')">CSV</button>
                    <button class="btn btn-danger btn-sm" onclick="exportDesignation('pdf')">PDF</button>
                    <button class="btn btn-secondary btn-sm" onclick="window.print()">Print</button>
                </div>
            </div>
            <div class="table-responsive">
                <table class="table table-bordered table-hover table-sm" id="tblDesignation" style="font-size:13px;">
                    <thead class="bg-secondary text-white">
                        <tr>
                            <th>Edit</th>
                            <th>Delete</th>
                            <th data-sort="designationcode">designationcode</th>
                            <th data-sort="designationName">designationName</th>
                            <th data-sort="probation">probation</th>
                            <th data-sort="insCatergory">insurance Catergory</th>
                            <th data-sort="insamount">insurance amount</th>
                            <th data-sort="CreatedBy">Created By</th>
                            <th data-sort="CreatedOn">Created On</th>
                            <th data-sort="EditedBy">Edited By</th>
                            <th data-sort="EditedOn">Edited On</th>
                            <th data-sort="isActive">isActive</th>
                        </tr>
                        <tr class="bg-light text-dark">
                            <th></th>
                            <th></th>
                            <th><input class="form-control form-control-sm column-search" data-field="designationcode" /></th>
                            <th><input class="form-control form-control-sm column-search" data-field="designationName" /></th>
                            <th><input class="form-control form-control-sm column-search" data-field="probation" /></th>
                            <th><input class="form-control form-control-sm column-search" data-field="insCatergory" /></th>
                            <th><input class="form-control form-control-sm column-search" data-field="insamount" /></th>
                            <th><input class="form-control form-control-sm column-search" data-field="createdBy" /></th>
                            <th></th>
                            <th><input class="form-control form-control-sm column-search" data-field="editedBy" /></th>
                            <th></th>
                            <th><input class="form-control form-control-sm column-search" data-field="isActive" /></th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
            <div class="d-flex justify-content-between align-items-center">
                <span id="recordInfo"></span>
                <div>
                    <button class="btn btn-outline-secondary btn-sm" id="btnPrev">Prev</button>
                    <span id="pageInfo" class="mx-2"></span>
                    <button class="btn btn-outline-secondary btn-sm" id="btnNext">Next</button>
                </div>
            </div>
        </div>
    </div>
</div>


<div class="modal fade" id="designationModal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-dialog-centered master-custom-modal" role="document">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="designationModalTitle">Add Designation</h5>
                <button type="button" class="close text-white" data-dismiss="modal"><span>&times;</span></button>
            </div>
            <div class="modal-body">
                <div class="master-form-wrapper">
                    <form id="designationForm">
                        <input type="hidden" id="sno" name="Sno" value="0" />

                        <div class="row gx-0 justify-content-center align-items-center master-form-row">
                            <label class="col-md-4 col-form-label text-end pe-1">Designation Name<span class="required-star">*</span></label>
                            <div class="col-md-6 ps-1">
                                <input class="form-control" id="designationName" name="designationName" required maxlength="150" />
                            </div>
                        </div>

                        <div class="row gx-0 justify-content-center align-items-center master-form-row">
                            <label class="col-md-4 col-form-label text-end pe-1">Designation Code<span class="required-star">*</span></label>
                            <div class="col-md-6 ps-1">
                                <input class="form-control" id="designationcode" name="designationcode" required maxlength="50" />
                            </div>
                        </div>

                        @* <div class="row gx-0 justify-content-center align-items-center master-form-row">
                            <label class="col-md-4 col-form-label text-end pe-1">Insurance Category Search</label>
                            <div class="col-md-6 ps-1">
                                <input class="form-control" id="insuranceCategorySearch" placeholder="Search A/B/C/D" />
                            </div>
                        </div> *@

                        <div class="row gx-0 justify-content-center align-items-center master-form-row">
                            <label class="col-md-4 col-form-label text-end pe-1">Insurance Category<span class="required-star">*</span></label>
                            <div class="col-md-6 ps-1">
                                <select class="form-control" id="insCatergory" name="insCatergory" required></select>
                            </div>
                        </div>

                       @*  <div class="row gx-0 justify-content-center align-items-center master-form-row">
                            <label class="col-md-4 col-form-label text-end pe-1">Probation Search</label>
                            <div class="col-md-6 ps-1">
                                <input class="form-control" id="probationSearch" placeholder="Search 0/3/4/6" />
                            </div>
                        </div> *@

                        <div class="row gx-0 justify-content-center align-items-center master-form-row">
                            <label class="col-md-4 col-form-label text-end pe-1">Probation<span class="required-star">*</span></label>
                            <div class="col-md-6 ps-1">
                                <select class="form-control" id="probation" name="probation" required></select>
                            </div>
                        </div>

                        <div class="row gx-0 justify-content-center align-items-center master-form-row">
                            <label class="col-md-4 col-form-label text-end pe-1">Insurance Amount<span class="required-star">*</span></label>
                            <div class="col-md-6 ps-1">
                                <input type="number" step="0.01" min="0" class="form-control" id="insamount" name="insamount" required />
                            </div>
                        </div>

                        <div class="alert d-none" id="formMessage"></div>
                    </form>
                </div>
            </div>
            <div class="modal-footer justify-content-center master-modal-footer">
                <button type="button" class="btn btn-secondary px-4" data-dismiss="modal"><i class="fa fa-times"></i> Cancel</button>
                <button type="button" class="btn btn-primary px-4" onclick="saveDesignation()"><i class="fa fa-save"></i> Save</button>
            </div>
        </div>
    </div>
</div>


<div class="modal fade inactive-edit-confirm-modal" id="inactiveEditConfirmModal" tabindex="-1" role="dialog" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content border-warning">
            <div class="modal-header bg-warning text-dark">
                <h5 class="modal-title">Confirm Edit</h5>
                <button type="button" class="close text-dark" onclick="cancelInactiveEdit()"><span>&times;</span></button>
            </div>
            <div class="modal-body text-center">
                <p class="mb-0 font-weight-bold">You are going to edit the Inactive record, please confirm if you want to proceed?</p>
            </div>
            <div class="modal-footer justify-content-center">
                <button type="button" class="btn btn-secondary px-4" onclick="cancelInactiveEdit()">Cancel</button>
                <button type="button" class="btn btn-warning px-4" onclick="proceedInactiveEdit()">Proceed</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="deleteDesignationModal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white"><h5 class="modal-title">Confirm Delete</h5><button type="button" class="close text-white" data-dismiss="modal"><span>&times;</span></button></div>
            <div class="modal-body">Are you sure you want to delete this designation?</div>
            <div class="modal-footer"><button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button><button type="button" class="btn btn-danger" id="btnConfirmDesignationDelete">Delete</button></div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/master/jsDesignation.js"></script>
}
